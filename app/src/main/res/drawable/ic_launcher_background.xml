<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: full-bleed 108x108 canvas (the launcher masks it down
  to the visible 72x72). Brand gradient only - no shapes, so every mask shape
  (circle, squircle, rounded square) crops cleanly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item
                    android:color="#FF0E6B3C"
                    android:offset="0.0" />
                <item
                    android:color="#FF1FA35C"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle top-left highlight so the icon does not read as a flat block. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="30"
                android:gradientRadius="70">
                <item
                    android:color="#33FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
