<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed ("monochrome") layer for Android 13+ themed icons. The launcher tints
  this drawable with the user's wallpaper palette using its ALPHA channel only,
  so the declared colour is irrelevant - what matters is that the silhouette
  reads on its own. Same geometry and safe zone as ic_launcher_foreground, with
  the track ring kept semi-transparent so the ring/progress split survives the
  tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,30 A24,24 0 1 1 53.99,30"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.35"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,30 A24,24 0 1 1 30.365,49.832"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <path
        android:pathData="M44.55,64.5 C44.55,49.8 54,41.4 66.6,41.4 C66.6,55.05 57.15,64.5 44.55,64.5 Z"
        android:fillColor="#FFFFFF" />
</vector>
