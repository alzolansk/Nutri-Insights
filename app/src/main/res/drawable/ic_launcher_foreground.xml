<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: an original mark for this app - a daily-goal progress
  ring (the widget's core function) enclosing a leaf (nutrition).

  Everything is kept inside the 66x66 safe zone centred at (54,54): the ring's
  outer edge is at radius 27.25, well within the 33 the launcher guarantees to
  keep visible on every mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ring track: the remaining part of the daily goal. -->
    <path
        android:pathData="M54,30 A24,24 0 1 1 53.99,30"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.35"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Progress arc: ~78% of the goal, starting at 12 o'clock. -->
    <path
        android:pathData="M54,30 A24,24 0 1 1 30.365,49.832"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round" />

    <!-- Leaf: tip at the top-right, base at the bottom-left. -->
    <path
        android:pathData="M44.55,64.5 C44.55,49.8 54,41.4 66.6,41.4 C66.6,55.05 57.15,64.5 44.55,64.5 Z"
        android:fillColor="#FFFFFF" />
</vector>
